{
  "name": "volt",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source Windows optimizer: memory, cleanup, startup and reversible tweaks.",
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "pnpm --filter @volt/desktop tauri dev",
    "tauri": "pnpm --filter @volt/desktop tauri",
    "check:ui": "pnpm --filter @volt/desktop typecheck && pnpm --filter @volt/desktop test && pnpm --filter @volt/desktop boundaries",
    "check": "pwsh -NoProfile -File scripts/check.ps1",
    "check:arch": "node scripts/check-arch.mjs",
    "bindings": "pwsh -NoProfile -File scripts/bindings.ps1",
    "bindings:check": "pwsh -NoProfile -File scripts/bindings.ps1 -Check",
    "lint": "biome check .",
    "format": "biome check --write . && cargo fmt --all",
    "board": "backlog browser",
    "graph:sync": "codegraph sync"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@colbymchenry/codegraph": "1.6.2",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "backlog.md": "1.55.3",
    "lefthook": "2.2.2"
  }
}
